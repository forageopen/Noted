{
  "name": "noted",
  "version": "0.1.0",
  "private": true,
  "description": "Noted (FOGA) - browser-native Markdown viewer/editor",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.sw.json",
    "build": "esbuild src/main.ts src/sw.ts --bundle --format=esm --target=es2022 --outdir=dist --external:buffer"
  },
  "dependencies": {
    "docx": "^8.5.0",
    "marked": "^13.0.0"
  },
  "devDependencies": {
    "esbuild": "^0.23.0",
    "jsdom": "^24.1.0",
    "jszip": "^3.10.1",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  },
  "engines": {
    "node": ">=20"
  }
}
